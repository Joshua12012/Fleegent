#!/usr/bin/env bash
# ==============================================================================
# EDGE PLATFORM DEMO — 3-COMMAND CLIENT CONTROL CLI (edge-ctl)
# ==============================================================================
# Provides the exact 3-command operational lifecycle for the edge device:
#
#   1. ./edge-ctl setup   -> Downloads/sets up bundled binaries, dirs, and base model
#   2. ./edge-ctl run     -> Boots client microservices and connects to Cloud Server
#   3. ./edge-ctl purge   -> Stops all processes and completely wipes all files & data
# ==============================================================================

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

# ANSI Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info()  { echo -e "${CYAN}${BOLD}[EDGE-CTL]${NC} $1"; }
log_ok()    { echo -e "${GREEN}${BOLD}[OK]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}${BOLD}[WARN]${NC} $1"; }
log_err()   { echo -e "${RED}${BOLD}[ERROR]${NC} $1"; }

# ==============================================================================
# COMMAND 1: SETUP
# ==============================================================================
# Prepares the edge environment:
#  - Creates runtime data and model directories
#  - Generates edge device identity config (edge.json)
#  - Compiles/bundles binaries if not present
# ==============================================================================
cmd_setup() {
    echo -e "${BOLD}================================================================${NC}"
    echo -e "${BOLD}  🛠️  STEP 1: SETTING UP EDGE DEVICE ENVIRONMENT                ${NC}"
    echo -e "${BOLD}================================================================${NC}"

    mkdir -p data data/models

    # Create default device configuration if not present
    if [[ ! -f "data/edge.json" ]]; then
        cat <<EOF > data/edge.json
{
  "device_id": "edge-node-alpha-01",
  "hostname": "$(hostname)",
  "cloud_server_url": "http://127.0.0.1:8080",
  "nats_url": "127.0.0.1:4222",
  "active_model": "qwen-edge-diagnostic (v1.0.0)",
  "model_path": "data/models/qwen_v1.gguf",
  "created_at": $(date +%s)
}
EOF
        log_ok "Created edge device configuration: data/edge.json"
    fi

    # Compile/verify release binaries
    log_info "Verifying pre-compiled binaries and WASM bytecode..."
    ./run-edge.sh build

    log_ok "Setup complete! The edge client is ready to run."
    echo -e "\nRun the client now with:\n  ${BOLD}./edge-ctl run${NC}  or  ${BOLD}make client${NC}\n"
}

# ==============================================================================
# COMMAND 2: RUN
# ==============================================================================
# Launches the client microservice fleet and connects to the Cloud Server.
# ==============================================================================
cmd_run() {
    ./run-edge.sh run "$@"
}

# ==============================================================================
# COMMAND 3: STOP
# ==============================================================================
# Gracefully stops all edge client microservices without deleting data.
# ==============================================================================
cmd_stop() {
    echo -e "${BOLD}================================================================${NC}"
    echo -e "${BOLD}  ⏹️  STOPPING EDGE CLIENT MICROSERVICES                         ${NC}"
    echo -e "${BOLD}================================================================${NC}"

    log_warn "Stopping running edge microservices..."
    killall -9 inference_worker wasm_host storage_service gst-launch-1.0 ffmpeg 2>/dev/null || true
    pkill -x inference_worker 2>/dev/null || true
    pkill -x wasm_host 2>/dev/null || true
    pkill -x storage_service 2>/dev/null || true
    pkill -f "nats-server -p 4222" 2>/dev/null || true
    pkill -f "gst-launch-1.0|ffmpeg -f v4l2" 2>/dev/null || true
    pkill -x client_daemon 2>/dev/null || true
    killall -9 client_daemon 2>/dev/null || true
    rm -f /tmp/edge_live_frame.jpg 2>/dev/null || true
    sleep 0.5

    # If edge.json has device_id and cloud_server_url, inform the cloud of STOPPED status
    if [[ -f "data/edge.json" ]]; then
        DEVICE_ID=$(grep -o '"device_id":"[^"]*' data/edge.json | head -n1 | cut -d'"' -f4 || true)
        CLOUD_URL=$(grep -o '"cloud_server_url":"[^"]*' data/edge.json | head -n1 | cut -d'"' -f4 || true)
        if [[ -n "$DEVICE_ID" && -n "$CLOUD_URL" ]]; then
            curl -sSL -X POST "$CLOUD_URL/api/v1/devices/$DEVICE_ID/stop" >/dev/null 2>&1 || true
        fi
    fi

    log_ok "All edge client microservices stopped cleanly. Local data & configs preserved."
}

# ==============================================================================
# COMMAND 4: PURGE
# ==============================================================================
# Kills all edge processes, wipes runtime databases, models, and identity configs,
# and deregisters this device from the Cloud Server.
# ==============================================================================
cmd_purge() {
    echo -e "${BOLD}================================================================${NC}"
    echo -e "${BOLD}  🧹 STEP 4: PURGING EDGE CLIENT FROM SYSTEM                   ${NC}"
    echo -e "${BOLD}================================================================${NC}"

    log_warn "Stopping any running edge microservices..."
    killall -9 inference_worker wasm_host storage_service gst-launch-1.0 ffmpeg 2>/dev/null || true
    pkill -x inference_worker 2>/dev/null || true
    pkill -x wasm_host 2>/dev/null || true
    pkill -x storage_service 2>/dev/null || true
    pkill -f "nats-server -p 4222" 2>/dev/null || true
    pkill -f "gst-launch-1.0|ffmpeg -f v4l2" 2>/dev/null || true
    rm -f /tmp/edge_live_frame.jpg 2>/dev/null || true
    sleep 0.5

    # If edge.json has device_id and cloud_server_url, notify cloud to purge record
    if [[ -f "data/edge.json" ]]; then
        DEVICE_ID=$(grep -o '"device_id":"[^"]*' data/edge.json | head -n1 | cut -d'"' -f4 || true)
        CLOUD_URL=$(grep -o '"cloud_server_url":"[^"]*' data/edge.json | head -n1 | cut -d'"' -f4 || true)
        if [[ -n "$DEVICE_ID" && -n "$CLOUD_URL" ]]; then
            log_info "Notifying Cloud Server to deregister device $DEVICE_ID..."
            curl -sSL -X POST "$CLOUD_URL/api/v1/devices/$DEVICE_ID/purge" >/dev/null 2>&1 || true
        fi
    fi

    log_info "Deleting runtime data, models, databases, and logs..."
    rm -rf data /tmp/edge_supervisor.sock client_test.log trace.log

    # If running in a standalone client directory (not a development git checkout), remove all binaries and scripts
    if [[ ! -d "$ROOT_DIR/.git" ]]; then
        log_info "Standalone client installation detected — removing microservice binaries & scripts..."
        rm -f "$ROOT_DIR/client_daemon" \
              "$ROOT_DIR/inference_worker" \
              "$ROOT_DIR/storage_service" \
              "$ROOT_DIR/wasm_host" \
              "$ROOT_DIR/nats-server" \
              "$ROOT_DIR/wasm_worker.wasm" \
              "$ROOT_DIR/run-edge.sh" \
              "$ROOT_DIR/edge-ctl"
    fi

    log_ok "All edge client data, databases, and microservice files completely purged!"
    echo -e "${GREEN}${BOLD}System is clean. Zero residual files or running daemons.${NC}\n"
    pkill -x client_daemon 2>/dev/null || true
    killall -9 client_daemon 2>/dev/null || true
}

# ==============================================================================
# DISPATCHER
# ==============================================================================
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    setup|install)
        cmd_setup "$@"
        ;;
    run|start)
        cmd_run "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    test|verify)
        ./run-edge.sh test
        ;;
    benchmark|bench)
        ./scripts/benchmark_paper.sh "$@"
        ;;
    purge|uninstall|clean-all|delete)
        cmd_purge "$@"
        ;;
    *)
        echo -e "${BOLD}Edge Fleet Management Client CLI${NC}"
        echo "Usage: ./edge-ctl [command]"
        echo ""
        echo "Client Lifecycle Commands:"
        echo "  1. ./edge-ctl setup     - Download/setup all files, dirs, and bundled binaries"
        echo "  2. ./edge-ctl run       - Run the edge client and connect to the Cloud Server"
        echo "  3. ./edge-ctl stop      - Gracefully stop edge microservices (preserves data)"
        echo "  4. ./edge-ctl benchmark - Automated paper metrics benchmark (exports CSV tables & shuts down)"
        echo "  5. ./edge-ctl purge     - Stop all processes and completely purge all files & data"
        exit 1
        ;;
esac
