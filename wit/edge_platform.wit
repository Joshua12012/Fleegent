package edge:platform@0.1.0;

interface types {
    record metric {
        name: string,
        value: float64,
        timestamp: u64,
    }

    record processed-result {
        name: string,
        original-value: float64,
        alert: bool,
        reason: string,
    }
}

interface service-handler {
    use types.{metric, processed-result};

    handle-telemetry: func(input: metric) -> result<processed-result, string>;
}

world user-workload {
    export service-handler;
}
